{
  "name": "vue-blog",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vitepress --open",
    "build": "vitepress build",
    "serve": "vitepress serve",
    "publish-scheduled": "node scripts/publish-scheduled.mjs",
    "lint:text": "textlint 'posts/**/*.md' index.md",
    "lint:text:fix": "textlint --fix 'posts/**/*.md' index.md",
    "prepare": "lefthook install || true"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "~4.2.4",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.20.5",
    "daisyui": "~5.5.19",
    "dayjs": "^1.11.23",
    "gray-matter": "^4.0.3",
    "lefthook": "^2.2.2",
    "markdown-it": "^14.3.3",
    "markdown-it-cjk-friendly": "^2.0.3",
    "tailwindcss": "~4.2.4",
    "textlint": "^15.8.0",
    "textlint-filter-rule-allowlist": "^4.0.0",
    "textlint-filter-rule-comments": "^1.3.0",
    "textlint-rule-preset-ja-spacing": "^2.4.3",
    "textlint-rule-preset-ja-technical-writing": "^12.0.2",
    "textlint-rule-preset-jtf-style": "^3.0.3",
    "vitepress": "^2.0.0-alpha.21",
    "vitepress-machine-readability": "^0.2.1",
    "vue": "^3.5.45"
  }
}
